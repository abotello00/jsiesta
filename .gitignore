# Python / tooling caches
__pycache__/
*.pyc
*.egg-info/
.venv
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build outputs
cpp/build/
docs/_build/
docs/_doxygen/

# Knowledge-graph snapshots (rebuilt by kg/build_kg.py)
kg/generations/
kg/current

# Large local indexes and legacy exports (regenerated by index_docs.py / rebuild_index.py)
indexes/
/docs.db
/graph_nodes.json
/graph_edges.json

# Generated reports and run artefacts
reports/
*.junit.xml

# SIESTA run leftovers (runs belong in temp directories)
/CLOCK
/MESSAGES
/INPUT_TMP.*
/fdf.*.log
/*.alloc

# Local reference-path configuration (machine specific)
tests/external_refs.local.toml

# Sphinx pages regenerated by docs/conf.py on every build
docs/_generated/
refs_cache
refs_cache/
